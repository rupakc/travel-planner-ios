      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের ভাড়া ({{price}}) ইতিমধ্যেই এর নিচে — আজকের দামের নিচে নামলে আমরা জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der heutige Preis ({{price}}) liegt bereits darunter – wir melden uns, wenn er unter den heutigen Preis fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s fare ({{price}}) is already under this — we’ll tell you when it drops below today’s price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio de hoy ({{price}}) ya está por debajo de esto: te avisaremos cuando baje del precio de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tarif d’aujourd’hui ({{price}}) est déjà inférieur à ce seuil : nous vous préviendrons s’il passe sous le prix du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का किराया ({{price}}) पहले से इससे कम है — जब यह आज की कीमत से नीचे जाएगा, हम बता देंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天的票价（{{price}}）已低于此目标——当价格跌破今天的价格时，我们会通知你。"
          }
        }
      }
    },
