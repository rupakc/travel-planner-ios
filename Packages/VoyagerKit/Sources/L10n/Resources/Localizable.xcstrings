            "value" : "La clasificación global solo muestra alias y solo de quien se une. ¿Quieres aparecer?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le classement mondial n'affiche que des pseudos, et seulement pour ceux qui y participent. Voulez-vous y figurer ?"
