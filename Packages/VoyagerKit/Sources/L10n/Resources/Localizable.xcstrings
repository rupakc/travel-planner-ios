    "alerts:dialog.fare.anyDropHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু উল্লেখযোগ্য কমলে — কমপক্ষে $15 ও ৫%। দিনে একবারের বেশি নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur deutliche Rückgänge – mindestens 15 $ und 5 %. Höchstens einmal pro Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only meaningful drops — at least $15 and 5%. Never more than once a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo bajadas relevantes: al menos 15 $ y un 5 %. Nunca más de una vez al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement les baisses notables : au moins 15 $ et 5 %. Jamais plus d’une fois par jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ ज़रूरी गिरावट — कम से कम $15 और 5%। दिन में एक बार से ज़्यादा नहीं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在明显降价时提醒：至少降 $15 且降幅达 5%。每天最多一次。"
          }
        }
      }
    },
