    "mobile:rules.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভদ্র থাকুন এবং ভ্রমণ নিয়েই কথা বলুন। স্প্যাম, হয়রানি বা ব্যক্তিগত তথ্য নয়। রিপোর্ট ও ব্লক সবসময় করা যায়, আর পোস্ট পর্যালোচনা হতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei freundlich und bleibe beim Thema Reisen. Kein Spam, keine Belästigung, keine persönlichen Daten. Melden und Blockieren ist jederzeit möglich, und Beiträge können geprüft werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be kind and keep it about travel. No spam, harassment or personal details. Reports and blocks are always available, and posts may be reviewed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sé amable y habla de viajes. Nada de spam, acoso ni datos personales. Siempre puedes denunciar y bloquear, y las publicaciones pueden revisarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez bienveillant et restez dans le thème du voyage. Pas de spam, de harcèlement ni de données personnelles. Vous pouvez toujours signaler et bloquer, et les publications peuvent être examinées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विनम्र रहें और बातें यात्रा तक रखें। स्पैम, उत्पीड़न या निजी जानकारी नहीं। रिपोर्ट और ब्लॉक हमेशा उपलब्ध हैं, और पोस्ट की समीक्षा हो सकती है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请友善，内容请围绕旅行。禁止垃圾信息、骚扰和个人信息。你随时可以举报和屏蔽，帖子可能会被审核。"
          }
        }
      }
    },
