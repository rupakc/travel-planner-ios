    "alerts:page.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা দিনে প্রায় দুবার এই দামগুলো আবার দেখি এবং দাম কমা সত্যিই কাজের হলেই আপনাকে জানাই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir prüfen diese Preise etwa zweimal täglich und melden uns nur, wenn sich ein Rückgang lohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We re-check these prices about twice a day and tell you only when a drop is worth knowing about."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisamos estos precios unas dos veces al día y solo te avisamos cuando una bajada merece la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous revérifions ces prix environ deux fois par jour et ne vous prévenons que lorsqu’une baisse vaut la peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम इन कीमतों को दिन में लगभग दो बार दोबारा जाँचते हैं और सिर्फ़ तभी बताते हैं जब गिरावट वाकई काम की हो।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们每天会复查这些价格约两次，只有降价值得关注时才会通知你。"
          }
        }
      }
    },
