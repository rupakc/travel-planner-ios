    "onboarding:steps.firstTrip.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি গন্তব্য খুঁজুন, অথবা Voyager-কে বলুন আপনাকে চমকে দিতে।"
          }
        },
        "de" : {
          "stringUnit" : {
