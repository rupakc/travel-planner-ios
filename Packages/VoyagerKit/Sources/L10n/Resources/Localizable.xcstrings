    "search:tour.myPlan.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পছন্দের ফ্লাইট, হোটেল ও অ্যাক্টিভিটি আমার প্ল্যানে যোগ করুন, খরচ কোথায় যাচ্ছে দেখুন, তারপর ক্যালেন্ডারে যোগ করুন বা PDF হিসেবে সেভ করুন। যেকোনো প্রশ্নের জন্য চ্যাট আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge Flüge, Hotels und Aktivitäten, die dir gefallen, zu Mein Plan hinzu, sieh, wohin das Geld geht, und übernimm alles in deinen Kalender oder speichere es als PDF. Der Chat beantwortet unterwegs jede Frage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the flights, hotels and activities you like to My Plan, see where the money goes, then add it to your calendar or save it as a PDF. Chat is there for any question along the way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade a Mi plan los vuelos, hoteles y actividades que te gusten, mira en qué se va el dinero y luego añádelo a tu calendario o guárdalo como PDF. El chat te ayuda con cualquier duda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez à Mon plan les vols, hôtels et activités qui vous plaisent, voyez où va votre argent, puis ajoutez le tout à votre calendrier ou enregistrez-le en PDF. Le chat répond à toutes vos questions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पसंद की फ़्लाइट, होटल और गतिविधियाँ “मेरा प्लान” में जोड़ें, देखें पैसा कहाँ जा रहा है, फिर उसे अपने कैलेंडर में जोड़ें या PDF में सेव करें। रास्ते में किसी भी सवाल के लिए चैट मौजूद है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把喜欢的航班、酒店和活动加入“我的计划”，查看费用去向，再添加到日历或保存为 PDF。过程中有任何问题都可以问聊天助手。"
          }
        }
      }
    },
