        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, wie und wann Voyager dich über Preissenkungen informiert. Alarme in der App bleiben immer erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
