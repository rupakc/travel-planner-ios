    "socialShare:held" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ধন্যবাদ। আপনার আইডিয়া দেখা যাওয়ার আগে একটি দ্রুত পর্যালোচনার অপেক্ষায় আছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
