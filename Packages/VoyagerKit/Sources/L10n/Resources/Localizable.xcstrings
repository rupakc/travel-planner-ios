    "prep:items.money.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যাংককে জানান, একটি বাড়তি কার্ড ও কিছু স্থানীয় নগদ রাখুন।"
