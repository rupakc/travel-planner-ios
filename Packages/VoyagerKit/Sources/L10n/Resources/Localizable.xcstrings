    "alerts:dialog.price.liveIs" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইভ দাম <strong>{{price}}</strong>। আমরা দিনে প্রায় দুবার দেখব এবং কাজের কিছু হলেই জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Live-Preis beträgt <strong>{{price}}</strong>. Wir prüfen etwa zweimal täglich und melden uns nur, wenn es sich lohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The live price is <strong>{{price}}</strong>. We’ll check about twice a day and only speak up when it’s worth it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El precio en directo es <strong>{{price}}</strong>. Comprobaremos unas dos veces al día y solo te avisaremos cuando merezca la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le prix en direct est de <strong>{{price}}</strong>. Nous vérifierons environ deux fois par jour et ne vous préviendrons que si cela vaut la peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव कीमत <strong>{{price}}</strong> है। हम दिन में लगभग दो बार जाँचेंगे और सिर्फ़ काम की बात होने पर बताएँगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时价格为 <strong>{{price}}</strong>。我们每天检查约两次，只在值得时通知你。"
          }
        }
      }
    },
    "alerts:dialog.price.liveLater" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা শিগগিরই লাইভ দাম নেব, তারপর দিনে প্রায় দুবার দেখব এবং কাজের কিছু হলেই জানাব।"
