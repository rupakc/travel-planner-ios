      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নজরদারিগুলো শেষ দামই ধরে রাখে; প্রতিটি দেখায় কখন যাচাই করা হয়েছিল।"
