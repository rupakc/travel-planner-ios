    "mobile:notifSettings.permissionDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager-এর নোটিফিকেশন বন্ধ আছে। রিমাইন্ডার ও দামের অ্যালার্ট পেতে সেটিংসে চালু করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für Voyager ausgeschaltet. Schalte sie in den Einstellungen ein, um Erinnerungen und Preisalarme zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are turned off for Voyager. Turn them on in Settings to get reminders and price alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Voyager están desactivadas. Actívalas en Ajustes para recibir recordatorios y alertas de precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées pour Voyager. Activez-les dans les Réglages pour recevoir des rappels et des alertes de prix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager के लिए सूचनाएँ बंद हैं। रिमाइंडर और कीमत के अलर्ट पाने के लिए उन्हें सेटिंग में चालू करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager 的通知已关闭。请在设置中开启，以接收提醒和价格提醒。"
          }
        }
      }
    },
    "mobile:notifSettings.pushUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সার্ভার থেকে পুশ নোটিফিকেশন এখনও পাওয়া যাচ্ছে না। অ্যাপের ভেতরের নোটিফিকেশন কাজ করছে।"
