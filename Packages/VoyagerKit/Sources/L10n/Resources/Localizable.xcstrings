        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রাপ্তবয়স্ক, শিশু, প্রবীণ, কোলের শিশু ও অ্যাক্সেসিবিলিটির প্রয়োজন — প্রতিটি সার্চে আগে থেকে ভরা থাকে"
