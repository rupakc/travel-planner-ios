    "account:prefs.taste.confirmReset" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেখা রুচির প্রোফাইল রিসেট করবেন? ভবিষ্যতের সার্চ আর আগের প্ল্যান থেকে আপনার মতো সাজানো হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gelerntes Geschmacksprofil zurücksetzen? Künftige Suchen werden nicht mehr anhand früherer Pläne personalisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset your learned taste profile? Future searches will no longer be personalised from past plans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Restablecer tu perfil de gustos? Las próximas búsquedas dejarán de personalizarse con tus planes anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialiser votre profil de goûts ? Les prochaines recherches ne seront plus personnalisées d’après vos plans passés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सीखा हुआ पसंद का प्रोफ़ाइल रीसेट करें? आगे की खोजें पुराने प्लान के आधार पर आपके अनुसार नहीं होंगी।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要重置已学习的口味画像吗？之后的搜索将不再根据过往行程个性化。"
          }
        }
      }
    },
    "account:prefs.taste.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনও কিছু শেখা হয়নি — কয়েকটি ভ্রমণ প্ল্যান সেভ করুন, পরের সার্চ নিজে থেকেই আপনার মতো হবে।"
