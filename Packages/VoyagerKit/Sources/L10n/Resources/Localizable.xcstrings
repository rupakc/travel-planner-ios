    "alerts:dialog.fare.nearbyHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কয়েক দিন আগে বা পরে রওনা দিলে (ভ্রমণের দৈর্ঘ্য একই রেখে) অন্তত $25 বাঁচলে আমরা জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir melden uns auch, wenn eine Abreise ein paar Tage früher oder später mindestens 25 $ spart – bei gleicher Reisedauer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll also tell you if leaving a few days earlier or later saves at least $25, keeping the same trip length."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También te avisaremos si salir unos días antes o después ahorra al menos 25 $, con la misma duración de viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous vous préviendrons aussi si partir quelques jours plus tôt ou plus tard économise au moins 25 $, à durée de voyage égale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कुछ दिन पहले या बाद निकलने पर, उतनी ही यात्रा अवधि में, कम से कम $25 बचते हैं तो हम बताएँगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果提前或推迟几天出发（行程天数不变）至少能省 $25，我们也会通知你。"
          }
        }
      }
    },
