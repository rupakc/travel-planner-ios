    "social:editor.visibilityNote.followers" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি ফলো অনুরোধ গ্রহণ না করা পর্যন্ত অন্যরা শুধু আপনার হ্যান্ডল ও সংখ্যা দেখবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere sehen nur dein Handle und die Zahlen, bis du ihre Anfrage annimmst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Others see only your handle and counts until you accept their follow request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los demás solo ven tu alias y los contadores hasta que aceptes su solicitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres ne voient que votre pseudo et les compteurs tant que vous n'avez pas accepté leur demande."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक आप फ़ॉलो अनुरोध स्वीकार नहीं करते, दूसरों को सिर्फ़ आपका हैंडल और संख्याएँ दिखती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你接受关注申请之前，其他人只能看到你的昵称和数量。"
          }
        }
      }
    },
    "social:editor.visibilityNote.private" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ আপনাকে খুঁজে পাবে না, এবং আপনিও আইডিয়া পোস্ট করতে পারবেন না।"
