    "signup:login.pendingBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা {{hint}} ঠিকানায় একটি নিশ্চিতকরণ লিংক পাঠিয়েছি। অ্যাকাউন্ট তৈরি শেষ করতে লিংকটি খুলুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben einen Bestätigungslink an {{hint}} gesendet. Öffne ihn, um dein Konto fertig zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sent a confirmation link to {{hint}}. Open it to finish creating your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos un enlace de confirmación a {{hint}}. Ábrelo para terminar de crear tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons envoyé un lien de confirmation à {{hint}}. Ouvrez-le pour terminer la création de votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमने {{hint}} पर एक पुष्टि लिंक भेजा है। खाता बनाना पूरा करने के लिए उसे खोलें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们已向 {{hint}} 发送了确认链接。打开链接即可完成账户创建。"
          }
        }
      }
    },
