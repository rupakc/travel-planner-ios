    "search:tour.recent.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সাম্প্রতিক সার্চ এখানে আছে। বদলাতে লোড করুন, অথবা হুবহু আবার চালান।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier findest du deine letzten Suchen. Lade eine, um sie anzupassen, oder starte sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your recent searches live here. Load one to tweak it, or run it again as it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí están tus búsquedas recientes. Carga una para ajustarla o repítela tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos recherches récentes se trouvent ici. Chargez-en une pour la modifier, ou relancez-la telle quelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी हाल की खोजें यहाँ हैं। किसी को बदलने के लिए लोड करें, या उसे जैसा है वैसा दोबारा चलाएँ।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
