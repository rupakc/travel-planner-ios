    "alerts:checks.errored" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইভ ভাড়া টানা তিনবার ব্যর্থ হয়েছে, তাই চেক বন্ধ আছে। প্রস্তুত হলে আবার চেষ্টা চাপুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Live-Preise sind dreimal in Folge fehlgeschlagen, deshalb sind die Prüfungen pausiert. Tippe auf „Wiederholen“, wenn du so weit bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live fares failed three times in a row, so checks are on hold. Use Retry when you’re ready."
