    "social:editor.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার হ্যান্ডলই আপনার একমাত্র প্রকাশ্য নাম। আপনার ইউজারনেম, ইমেইল ও আসল নাম কখনও দেখানো হয় না। বাকিটা কে দেখবে তা আপনি ঠিক করেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Handle ist dein einziger öffentlicher Name. Benutzername, E-Mail und echter Name werden nie angezeigt. Du entscheidest, wer den Rest sieht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your handle is your only public name. Your username, email and real name are never shown. You decide who sees the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu alias es tu único nombre público. Tu nombre de usuario, tu correo y tu nombre real nunca se muestran. Tú decides quién ve el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pseudo est votre seul nom public. Votre identifiant, votre e-mail et votre vrai nom ne sont jamais affichés. Vous choisissez qui voit le reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका हैंडल ही आपका एकमात्र सार्वजनिक नाम है। आपका यूज़रनेम, ईमेल और असली नाम कभी नहीं दिखाए जाते। बाकी कौन देखे, यह आप तय करते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的昵称是你唯一的公开名称。你的用户名、邮箱和真实姓名绝不会显示。其余内容由你决定谁可以看到。"
          }
        }
      }
    },
