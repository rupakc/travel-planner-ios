    "chat:page.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ট্রাভেল অ্যাসিস্ট্যান্ট। গুরুত্বপূর্ণ তথ্য সরকারি সূত্রে যাচাই করে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-Reiseassistent. Prüfe wichtige Angaben bei offiziellen Stellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-powered travel assistant. Verify important details with official sources."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistente de viajes con IA. Verifica los datos importantes en fuentes oficiales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistant de voyage IA. Vérifiez les informations importantes auprès de sources officielles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI ट्रैवल असिस्टेंट। ज़रूरी जानकारी आधिकारिक स्रोतों से जाँच लें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 旅行助手。重要信息请向官方渠道核实。"
          }
        }
      }
    },
    "chat:page.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার AI ট্রাভেল অ্যাসিস্ট্যান্টের সঙ্গে চ্যাট করুন। পুরো ভ্রমণ প্ল্যান চাইলে ফলাফল ইন্টারঅ্যাকটিভ কার্ড হিসেবে লাইভ আসবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatte mit deinem KI-Reiseassistenten. Frag nach einem kompletten Reiseplan und die Ergebnisse erscheinen live als interaktive Karten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat with your AI travel assistant. Ask for a full trip plan and results will stream in real-time with interactive cards."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chatea con tu asistente de viajes con IA. Pídele un plan de viaje completo y los resultados llegarán en tiempo real con tarjetas interactivas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutez avec votre assistant de voyage IA. Demandez un plan de voyage complet : les résultats arrivent en direct sous forme de cartes interactives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने AI ट्रैवल असिस्टेंट से चैट करें। पूरा यात्रा प्लान माँगें, नतीजे इंटरैक्टिव कार्ड के रूप में लाइव आते जाएँगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与你的 AI 旅行助手聊天。你可以让它制定完整行程，结果会以互动卡片的形式实时呈现。"
          }
        }
      }
    },
