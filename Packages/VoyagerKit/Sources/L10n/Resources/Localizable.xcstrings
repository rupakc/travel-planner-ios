        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैश्विक बोर्ड केवल हैंडल दिखाता है, और सिर्फ़ उन्हीं के जो जुड़ते हैं। क्या आप जुड़ना चाहते हैं?"
