        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লিঙ্কে কী দেখাবে তা বেছে নিন। আপনার ইমেল, জাতীয়তা ও ভিসার তথ্য কখনও শেয়ার হয় না।"
