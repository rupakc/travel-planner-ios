    "alerts:live.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এইমাত্র লাইভ ওয়েব সার্চ থেকে। দাম দ্রুত বদলায় — বুকিংয়ের আগে প্রদানকারীর কাছে যাচাই করুন। আপনার দামের অ্যালার্টে এটি ব্যবহার হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einer Live-Websuche von eben. Preise ändern sich schnell – prüfe vor der Buchung beim Anbieter. Wird nicht für deine Preisalarme verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From a live web search just now. Prices change quickly — check the provider before booking. Not used for your price alerts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De una búsqueda web en directo ahora mismo. Los precios cambian rápido: confirma con el proveedor antes de reservar. No se usa para tus alertas de precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issu d’une recherche web en direct à l’instant. Les prix changent vite : vérifiez auprès du prestataire avant de réserver. Non utilisé pour vos alertes de prix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी की लाइव वेब खोज से। कीमतें जल्दी बदलती हैं — बुक करने से पहले प्रदाता से जाँच लें। आपके कीमत अलर्ट में इसका उपयोग नहीं होता।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自刚刚的实时网络搜索。价格变化很快，预订前请向服务商确认。不用于你的价格提醒。"
          }
        }
      }
    },
