      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} এই ভ্রমণের কোনো স্টপ নয়, আর একটি ভ্রমণে সর্বোচ্চ ৩টি স্টপ থাকে — বরং এটিকে কোনো একটি স্টপে যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} ist kein Stopp dieser Reise, und eine Reise hat höchstens 3 – füge es stattdessen einem davon hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} isn't one of this trip's stops, and a trip has at most 3 — add it to one of them instead."
