    "coach:steps.create.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তারিখ জানা না থাকলেও এখানে ভ্রমণ তৈরি করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege hier eine Reise an, auch wenn du die Daten noch nicht kennst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a trip here, even before you know the dates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un viaje aquí, aunque todavía no sepas las fechas."
          }
