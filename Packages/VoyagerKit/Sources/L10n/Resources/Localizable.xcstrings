    "coach:steps.explore.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নতুন ভাবনা শুরু করতে খুঁজুন, চ্যাট করুন এবং কাছের জায়গা দেখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche, chatte und finde Orte in deiner Nähe, um eine neue Idee zu starten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search, chat and find places near you to start a new idea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca, chatea y descubre lugares cerca de ti para empezar una idea nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cherchez, discutez et trouvez des lieux près de vous pour lancer une nouvelle idée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया विचार शुरू करने के लिए खोजें, चैट करें और अपने पास की जगहें देखें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索、聊天并查找你附近的地点，开启新的想法。"
          }
        }
      }
    },
