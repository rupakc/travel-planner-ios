    "results:emergency.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই তথ্য শুধু সাধারণ নির্দেশনার জন্য। সবসময় অফিসিয়াল সূত্রে বর্তমান তথ্য যাচাই করুন। দূতাবাসের সময় ও হাসপাতালের সেবা বদলাতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Angaben dienen nur der allgemeinen Orientierung. Prüfe aktuelle Details immer bei offiziellen Stellen. Öffnungszeiten von Botschaften und Leistungen von Krankenhäusern können sich ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Information provided for general guidance only. Always verify current details with official sources. Embassy hours and hospital services may change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Información solo orientativa. Verifica siempre los datos actuales en fuentes oficiales. Los horarios de las embajadas y los servicios hospitalarios pueden cambiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informations données à titre indicatif uniquement. Vérifiez toujours les détails actuels auprès de sources officielles. Les horaires des ambassades et les services hospitaliers peuvent changer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह जानकारी केवल सामान्य मार्गदर्शन के लिए है। हमेशा आधिकारिक स्रोतों से ताज़ा ब्योरा जाँच लें। दूतावास के समय और अस्पताल की सेवाएँ बदल सकती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以上信息仅供参考，请务必通过官方渠道核实最新情况。大使馆办公时间和医院服务可能会有变动。"
          }
        }
      }
    },
