    "sections:stress.blurb" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ভ্রমণসূচি, ফ্লাইট, ভিসার সময়রেখা, আবহাওয়া ও বাজেটের কড়া পর্যালোচনা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kritische Prüfung von Reiseverlauf, Flügen, Visa-Fristen, Wetter und Budget."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adversarial review of your itinerary, flights, visa timeline, weather and budget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisión crítica de tu itinerario, vuelos, plazos de visado, clima y presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Examen critique de votre itinéraire, de vos vols, des délais de visa, de la météo et du budget."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके यात्रा कार्यक्रम, फ़्लाइटों, वीज़ा समय-सीमा, मौसम और बजट की सख़्त जाँच।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对你的行程、航班、签证时间线、天气和预算进行严格审查。"
          }
        }
      }
    },
