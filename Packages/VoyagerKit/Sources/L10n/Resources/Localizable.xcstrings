    "search:recent.loadedShifted" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{route}} লোড হয়েছে। এর তারিখ পেরিয়ে গিয়েছিল, তাই এখন একই সময়কালে আগামী সপ্তাহ থেকে শুরু হচ্ছে — দেখে নিন, তারপর প্ল্যান করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{route}} geladen. Die Daten lagen in der Vergangenheit, deshalb beginnt die Reise jetzt nächste Woche mit gleicher Dauer – prüfe sie und plane dann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loaded {{route}}. Its dates had passed, so they now start next week with the same trip length — check them, then plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cargó {{route}}. Sus fechas ya habían pasado, así que ahora empiezan la próxima semana con la misma duración. Revísalas y planifica."
          }
        },
        "fr" : {
          "stringUnit" : {
