    "onboarding:web.resultSkipped" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি সব প্রশ্ন এড়িয়ে গেছেন, তাই আমরা একটি বিস্তৃত মিশ্রণ দিয়ে শুরু করেছি। যেকোনো সময় কুইজ আবার দিতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast alle Fragen übersprungen, daher starten wir mit einer breiten Mischung. Du kannst das Quiz jederzeit wiederholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You skipped every question, so we started you with a broad mix. You can retake the quiz any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te has saltado todas las preguntas, así que empezamos con una mezcla amplia. Puedes repetir el cuestionario cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez passé toutes les questions, nous avons donc commencé avec un large éventail. Vous pouvez refaire le quiz à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने सभी सवाल छोड़ दिए, इसलिए हमने एक व्यापक मिश्रण से शुरुआत की है। आप क्विज़ कभी भी दोबारा दे सकते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你跳过了所有问题，所以我们先为你选了一组广泛的组合。你可以随时重新测验。"
          }
        }
      }
    },
