      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এমন পরিকল্পনা যা আপনার প্রবেশগম্যতার প্রয়োজন বিবেচনা করে।"
