    },
    "socialShare:intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই প্ল্যানের একটি ঝলক প্রকাশ করুন: গন্তব্য, ভ্রমণের দিন এবং আপনার বেছে নেওয়া জায়গা। তারিখ, দাম, আপনি কোথা থেকে যাচ্ছেন এবং আপনার নাম কখনও অন্তর্ভুক্ত হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veröffentliche eine Momentaufnahme dieses Plans: Reiseziele, Reisedauer und die Orte, die du ausgewählt hast. Daten, Preise, dein Abreiseort und dein Name sind nie enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publish a snapshot of this plan: destinations, trip length and the places you picked. Dates, prices, where you travel from and your name are never included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publica una instantánea de este plan: destinos, duración del viaje y los lugares que elegiste. Nunca se incluyen fechas, precios, tu ciudad de origen ni tu nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publiez un aperçu de ce plan : destinations, durée du voyage et lieux choisis. Les dates, les prix, votre ville de départ et votre nom ne sont jamais inclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस प्लान की झलक प्रकाशित करें: गंतव्य, यात्रा की अवधि और आपकी चुनी हुई जगहें। तारीखें, कीमतें, आप कहाँ से यात्रा करेंगे और आपका नाम कभी शामिल नहीं होते।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布此计划的快照：目的地、行程天数和你选择的地点。绝不包含日期、价格、出发地和你的姓名。"
          }
        }
      }
    },
