    "coach:steps.alerts.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নজরে থাকা ভাড়া বা দাম কমলে জানানো হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst einen Hinweis, wenn ein beobachteter Preis sinkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a nudge when a fare or price you watch drops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos cuando baje una tarifa o un precio que sigues."
