    "notifications:cap.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একদিনে আমরা সর্বোচ্চ কতগুলো রিমাইন্ডার ও সারাংশ পাঠাব। দাম কমার বিজ্ঞপ্তি এতে গোনা হয় না।"
