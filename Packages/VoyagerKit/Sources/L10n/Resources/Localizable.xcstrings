    "search:compare.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুরো প্ল্যান করার আগে দুটি বা তিনটি গন্তব্য পাশাপাশি তুলনা করুন — খরচ, ফ্লাইট, হোটেল, আবহাওয়া ও ভিসা।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche zwei oder drei Reiseziele nebeneinander – Kosten, Flüge, Hotels, Wetter und Visum –, bevor du dich für einen ganzen Plan entscheidest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare two or three destinations side by side — cost, flights, hotels, weather and visa — before you commit to a full plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara dos o tres destinos lado a lado (coste, vuelos, hoteles, clima y visado) antes de comprometerte con un plan completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez deux ou trois destinations côte à côte (coût, vols, hôtels, météo et visa) avant de vous lancer dans un plan complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरा प्लान बनाने से पहले दो या तीन मंज़िलों की आमने-सामने तुलना करें — खर्च, फ़्लाइट, होटल, मौसम और वीज़ा।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在制定完整计划之前，并排对比两三个目的地的费用、航班、酒店、天气和签证。"
          }
        }
      }
    },
