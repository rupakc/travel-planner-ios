    "alertsHub:digest.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সপ্তাহে আপনার নজরদারিগুলো কেমন বদলেছে তা এখানে। দামগুলো আমাদের শেষ দেখা দাম।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So haben sich deine Beobachtungen diese Woche bewegt. Die Preise sind die letzten, die wir beobachtet haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Here is how your watches moved this week. Prices are the last ones we observed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Así se movieron tus vigilancias esta semana. Los precios son los últimos que observamos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici comment vos suivis ont évolué cette semaine. Les prix sont les derniers que nous avons observés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस हफ़्ते आपकी निगरानी में क्या बदला, यह यहाँ है। कीमतें वही हैं जो हमने आख़िरी बार देखीं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是本周你关注的项目的变化。价格为我们最近一次观察到的价格。"
          }
        }
      }
    },
