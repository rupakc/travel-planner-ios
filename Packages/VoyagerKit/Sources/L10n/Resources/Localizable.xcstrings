    "onboarding:web.syncFailedBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার উত্তর এই ডিভাইসে রাখা আছে। আপনার আগ্রহ, বাজেট, ভ্রমণ দল ও পাসপোর্ট অ্যাকাউন্টে পৌঁছায়নি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Antworten bleiben auf diesem Gerät. Deine Interessen, dein Budget, deine Reisegruppe und dein Reisepass wurden nicht in dein Konto übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your answers are kept on this device. Your interests, budget, travel group and passport didn't reach your account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus respuestas se quedan en este dispositivo. Tus intereses, presupuesto, grupo de viaje y pasaporte no llegaron a tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos réponses restent sur cet appareil. Vos centres d’intérêt, votre budget, votre groupe de voyage et votre passeport n’ont pas atteint votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके जवाब इस डिवाइस पर रखे गए हैं। आपकी रुचियाँ, बजट, यात्रा समूह और पासपोर्ट आपके खाते तक नहीं पहुँचे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的答案保留在此设备上。你的兴趣、预算、同行人员和护照信息未能同步到你的账户。"
          }
        }
      }
    },
