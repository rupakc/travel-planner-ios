          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search for a destination, or ask Voyager to surprise you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca un destino o pide a Voyager que te sorprenda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez une destination ou demandez à Voyager de vous surprendre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई गंतव्य खोजें, या Voyager से कहें कि वह आपको चौंका दे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索目的地，或让 Voyager 给你一个惊喜。"
          }
        }
      }
    },
