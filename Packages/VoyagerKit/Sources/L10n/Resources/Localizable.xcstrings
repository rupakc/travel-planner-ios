    "search:tour.preferences.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে দেওয়া জাতীয়তা, ভিসা, যাত্রী ও আগ্রহ “পছন্দ” পেজে সেভ হয় এবং পরের বার এই ফর্মে নিজে থেকে বসে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatsangehörigkeit, Visa, Reisende und Interessen, die du hier nutzt, werden in den Einstellungen gespeichert und beim nächsten Mal automatisch eingetragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nationality, visas, travelers and interests you use here are saved to Preferences, and they pre-fill this form next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nacionalidad, los visados, los viajeros y los intereses que uses aquí se guardan en Preferencias y rellenan este formulario la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nationalité, les visas, les voyageurs et les centres d’intérêt saisis ici sont enregistrés dans les Préférences et préremplissent ce formulaire la prochaine fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ आप जो राष्ट्रीयता, वीज़ा, यात्री और रुचियाँ भरते हैं, वे प्राथमिकताओं में सेव हो जाती हैं और अगली बार इस फ़ॉर्म में अपने-आप भर जाती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在这里填写的国籍、签证、出行人数和兴趣会保存到偏好设置，下次自动填入此表单。"
          }
        }
      }
    },
