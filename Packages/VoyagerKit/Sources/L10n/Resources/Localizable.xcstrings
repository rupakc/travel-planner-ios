    "alerts:bell.emptyBody" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো ফ্লাইট, হোটেল, অ্যাক্টিভিটি বা পুরো ভ্রমণ ট্র্যাক করুন, দাম কমলে এখানে জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachte einen Flug, ein Hotel, eine Aktivität oder eine ganze Reise – hier erfährst du, wenn der Preis fällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch a flight, hotel, activity or whole trip and we’ll tell you here when its price drops."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila un vuelo, hotel, actividad o viaje entero y te avisaremos aquí cuando baje su precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez un vol, un hôtel, une activité ou tout un voyage et nous vous préviendrons ici quand son prix baisse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई फ़्लाइट, होटल, गतिविधि या पूरी यात्रा ट्रैक करें, कीमत गिरते ही हम यहाँ बता देंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关注航班、酒店、活动或整个行程，价格下降时我们会在这里通知你。"
          }
        }
      }
    },
