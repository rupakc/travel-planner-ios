    "alerts:page.emptyOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্লাইট, হোটেল, অ্যাক্টিভিটি ও ভ্রমণ ট্র্যাক করতে লাইভ দাম লাগে, যা এই সার্ভারে এখনো সেট করা নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für die Beobachtung von Flügen, Hotels, Aktivitäten und Reisen braucht es Live-Preise, die auf diesem Server noch nicht eingerichtet sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watching flights, hotels, activities and trips needs live prices, which aren’t set up on this server yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigilar vuelos, hoteles, actividades y viajes requiere precios en directo, que aún no están configurados en este servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La surveillance des vols, hôtels, activités et voyages nécessite des prix en direct, qui ne sont pas encore configurés sur ce serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लाइटों, होटलों, गतिविधियों और यात्राओं को ट्रैक करने के लिए लाइव कीमतें चाहिए, जो इस सर्वर पर अभी सेट नहीं हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关注航班、酒店、活动和行程需要实时价格，而此服务器尚未配置。"
          }
        }
      }
    },
    "alerts:page.emptyOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ফলাফল থেকে কোনো ফ্লাইটের ভাড়া, হোটেল, অ্যাক্টিভিটি বা পুরো সেভ করা ভ্রমণ ট্র্যাক করুন। আমরা দামের দিকে নজর রাখব এবং দাম কমলে বা আপনার চাওয়া দামে পৌঁছালে জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachte aus deinen Ergebnissen den Preis eines Flugs, Hotels, einer Aktivität oder einer ganzen gespeicherten Reise. Wir behalten den Preis im Blick und melden uns, wenn er fällt oder deinen Wunschpreis erreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch a flight’s fare, a hotel, an activity or a whole saved trip from your results. We’ll keep an eye on the price and let you know when it drops or hits the price you want."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vigila la tarifa de un vuelo, un hotel, una actividad o un viaje guardado entero desde tus resultados. Seguiremos el precio y te avisaremos cuando baje o llegue al precio que quieres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez depuis vos résultats le tarif d’un vol, un hôtel, une activité ou tout un voyage enregistré. Nous suivrons le prix et vous préviendrons dès qu’il baisse ou atteint le prix voulu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने नतीजों से किसी फ़्लाइट का किराया, होटल, गतिविधि या पूरी सेव की गई यात्रा ट्रैक करें। हम कीमत पर नज़र रखेंगे और गिरने या आपकी तय कीमत पर पहुँचने पर बता देंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在搜索结果中关注某个航班票价、酒店、活动或整个已保存的行程。我们会持续留意价格，在降价或达到你的目标价时通知你。"
          }
        }
      }
    },
