    "alerts:dialog.fare.todayFare" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের ভাড়া <strong>{{price}}</strong> ({{travellers}})। আমরা দিনে প্রায় দুবার দেখব এবং কাজের কিছু হলেই জানাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der heutige Preis liegt bei <strong>{{price}}</strong> ({{travellers}}). Wir prüfen etwa zweimal täglich und melden uns nur, wenn es sich lohnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s fare is <strong>{{price}}</strong> ({{travellers}}). We’ll check about twice a day and only speak up when it’s worth it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarifa de hoy es <strong>{{price}}</strong> ({{travellers}}). Comprobaremos unas dos veces al día y solo te avisaremos cuando merezca la pena."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tarif du jour est de <strong>{{price}}</strong> ({{travellers}}). Nous vérifierons environ deux fois par jour et ne vous préviendrons que si cela vaut la peine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का किराया <strong>{{price}}</strong> है ({{travellers}})। हम दिन में लगभग दो बार जाँचेंगे और सिर्फ़ काम की बात होने पर बताएँगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日票价为 <strong>{{price}}</strong>（{{travellers}}）。我们每天检查约两次，只在值得时通知你。"
          }
        }
      }
    },
    "alerts:dialog.fare.todayLater" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
