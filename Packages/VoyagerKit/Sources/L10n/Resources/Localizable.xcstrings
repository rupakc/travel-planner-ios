    "onboarding:steps.notifications.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণের রিমাইন্ডার ও দাম কমার অ্যালার্ট পান। আপনি সেটিংসে যেকোনোটি বন্ধ করতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte Reiseerinnerungen und Preissenkungs-Alarme. Du kannst jede Mitteilung in den Einstellungen ausschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get trip reminders and price-drop alerts. You can turn each one off in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe recordatorios de viaje y alertas de bajada de precio. Puedes desactivar cada uno en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez des rappels de voyage et des alertes de baisse de prix. Vous pouvez désactiver chacun d'eux dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा रिमाइंडर और दाम घटने के अलर्ट पाएँ। आप हर एक को सेटिंग में बंद कर सकते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取行程提醒和降价提醒。你可以在设置中分别关闭。"
          }
        }
      }
    },
