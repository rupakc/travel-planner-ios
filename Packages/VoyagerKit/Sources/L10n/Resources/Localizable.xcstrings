      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্রোফাইল, সেটিংস এবং এই ট্যুর, যখনই আবার দেখতে চান।"
