    "accountData:intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager-এ আপনার সম্পর্কে যা আছে তার একটি কপি ডাউনলোড করুন, অথবা আপনার অ্যাকাউন্ট চিরতরে মুছে দিন।"
