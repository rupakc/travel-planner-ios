    "prep:items.passport.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফেরার পর অন্তত ছয় মাস মেয়াদ এবং ফাঁকা পাতা থাকতে হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sollte nach deiner Rückkehr noch mindestens sechs Monate gültig sein und freie Seiten haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure it is valid for at least six months after you return and has blank pages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que sea válido al menos seis meses tras tu regreso y tenga páginas libres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il doit être valable au moins six mois après votre retour et avoir des pages vierges."
          }
