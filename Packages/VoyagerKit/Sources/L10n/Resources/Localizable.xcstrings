    "offlinePack:error.error" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাক সংরক্ষণ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket konnte nicht gespeichert werden. Versuch es noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not save the pack. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar el paquete. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d'enregistrer le pack. Réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैक सहेजा नहीं जा सका। फिर कोशिश करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存离线包，请重试。"
          }
        }
      }
    },
    "offlinePack:error.quota" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্যাক সংরক্ষণের জন্য এই ডিভাইসে যথেষ্ট জায়গা নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist nicht genug Speicher, um das Paket zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough storage on this device to save the pack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay espacio suficiente en este dispositivo para guardar el paquete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas assez d'espace sur cet appareil pour enregistrer le pack."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पैक सहेजने के लिए इस डिवाइस में पर्याप्त स्टोरेज नहीं है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备存储空间不足，无法保存离线包。"
          }
        }
      }
    },
    "offlinePack:intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জরুরি নম্বর, দরকারি বাক্য, হোটেলের ঠিকানা এবং মুদ্রা কনভার্টার এই ডিভাইসে সংরক্ষণ করুন, যাতে সংযোগ ছাড়াই কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere Notrufnummern, wichtige Sätze, die Adresse deines Hotels und einen Währungsrechner auf diesem Gerät, damit sie ohne Verbindung funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save emergency numbers, key phrases, your hotel address and a currency converter on this device, so they work without a connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda en este dispositivo los números de emergencia, frases clave, la dirección de tu hotel y un conversor de moneda para usarlos sin conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez sur cet appareil les numéros d'urgence, les phrases utiles, l'adresse de votre hôtel et un convertisseur de devises pour y accéder sans connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपातकालीन नंबर, ज़रूरी वाक्य, होटल का पता और मुद्रा कन्वर्टर इस डिवाइस पर सहेजें, ताकि ये बिना कनेक्शन के भी काम करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把紧急电话、常用语句、酒店地址和货币换算器保存在此设备上，没有网络也能使用。"
          }
        }
      }
    },
    "offlinePack:offlineNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অফলাইনে আছেন। সংরক্ষিত প্যাক দেখানো হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline. Das gespeicherte Paket wird angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are offline. Showing the saved pack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás sin conexión. Se muestra el paquete guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne. Le pack enregistré s'affiche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप ऑफ़लाइन हैं। सहेजा हुआ पैक दिखाया जा रहा है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你当前处于离线状态，显示的是已保存的离线包。"
          }
        }
      }
    },
