    "sections:emergency.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণের আগে সব তথ্য যাচাই করে নিন — তথ্য পুরোনো হতে পারে। পৌঁছে হোটেলের কনসিয়ার্জের কাছে নিশ্চিত হয়ে নিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe alle Angaben vor der Reise – sie können veraltet sein. Lass sie dir bei der Ankunft an der Hotelrezeption bestätigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verify all details before travel — information may be outdated. Confirm with hotel concierge on arrival."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica todos los datos antes de viajar: la información puede estar desactualizada. Confírmala con el conserje del hotel al llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez toutes les informations avant de partir : elles peuvent être périmées. Confirmez-les auprès de la conciergerie de l’hôtel à votre arrivée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा से पहले सारी जानकारी जाँच लें — यह पुरानी हो सकती है। पहुँचने पर होटल रिसेप्शन से पुष्टि कर लें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出行前请核实所有信息——内容可能已过时。抵达后请向酒店礼宾部确认。"
          }
        }
      }
    },
