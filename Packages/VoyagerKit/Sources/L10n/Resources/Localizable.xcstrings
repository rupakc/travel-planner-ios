    "alerts:trip.alertsNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যালার্ট শুধু তখনই আসে যখন লাইভ দাম মোটকে অন্তত $25 বা ৪% বদলায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preisalarme entstehen nur, wenn Live-Preise die Summe um mindestens 25 $ oder 4 % verändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerts come only from live prices moving the total by at least $25 or 4 %."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas solo vienen de precios en directo que muevan el total al menos 25 $ o un 4 %."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes ne viennent que des prix en direct qui font bouger le total d’au moins 25 $ ou 4 %."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अलर्ट सिर्फ़ तब आते हैं जब लाइव कीमतें कुल को कम से कम $25 या 4% बदल दें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有实时价格使总价变动至少 $25 或 4% 时才会提醒。"
          }
        }
      }
    },
