        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই অংশের শেষ যাচাই ব্যর্থ হয়েছে — আমাদের দেখা শেষ লাইভ দাম দেখানো হচ্ছে।"
          }
        },
        "de" : {
          "stringUnit" : {
