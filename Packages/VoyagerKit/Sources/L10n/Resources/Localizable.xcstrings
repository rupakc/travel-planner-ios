      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রওনা হওয়ার আগে ভ্রমণের রিমাইন্ডার, আপনার নজরে রাখা বিষয়ের দাম কমার অ্যালার্ট এবং ভ্রমণের সময় কাছাকাছি পরামর্শ পান। আপনি সেটিংসে যেকোনোটি বন্ধ করতে পারেন।"
