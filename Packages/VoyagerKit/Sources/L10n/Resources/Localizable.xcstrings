    "search:stops.routeNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্টপগুলো পথে ঘোরা হয়; “কোথায়” শহরটি আপনার শেষ গন্তব্য। ফাঁকা রাতগুলো নিজে থেকেই ভাগ হয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopps liegen auf dem Weg; die „Nach“-Stadt ist dein Endziel. Leere Nächte werden automatisch verteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops are visited on the way; the \"To\" city is your final destination. Nights left blank are split automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las paradas se visitan por el camino; la ciudad de «Destino» es tu destino final. Las noches en blanco se reparten automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les étapes se font en chemin ; la ville « Vers » est votre destination finale. Les nuits laissées vides sont réparties automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पड़ाव रास्ते में पड़ते हैं; \"कहाँ तक\" वाला शहर आपकी अंतिम मंज़िल है। खाली छोड़ी गई रातें अपने-आप बँट जाती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "途经站会在路上依次游览，“目的地”城市是最终目的地。留空的晚数会自动分配。"
          }
        }
      }
    },
