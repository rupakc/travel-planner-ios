    "onboarding:types.BUDGET_BACKPACKER.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি টাকা বুঝেশুনে খরচ: হোস্টেল, স্ট্রিট ফুড, বিনামূল্যের হাঁটা ভ্রমণ এবং সস্তা অফারের অ্যালার্ট।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden Cent umdrehen: Hostels, Streetfood, kostenlose Stadtführungen und Preisalarme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stretching every dollar: hostels, street food, free walking tours and deal alerts."
