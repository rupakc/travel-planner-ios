    "social:block.confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@{{handle}}-কে ব্লক করবেন? আপনারা একে অপরের প্রোফাইল, আইডিয়া বা মন্তব্য দেখতে পাবেন না এবং সব ফলো সরে যাবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@{{handle}} blockieren? Ihr seht gegenseitig weder Profil noch Ideen oder Kommentare, und bestehende Follows werden entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Block @{{handle}}? You will no longer see each other's profile, ideas or comments, and any follows are removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Bloquear a @{{handle}}? Dejaréis de ver el perfil, las ideas y los comentarios del otro, y se eliminan los seguimientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquer @{{handle}} ? Vous ne verrez plus le profil, les idées ni les commentaires l'un de l'autre, et les abonnements seront supprimés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@{{handle}} को ब्लॉक करें? आप एक-दूसरे की प्रोफ़ाइल, आइडिया या टिप्पणियाँ नहीं देख पाएँगे, और सभी फ़ॉलो हट जाएँगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要屏蔽 @{{handle}} 吗？你们将互相看不到对方的主页、灵感和评论，已有的关注也会解除。"
          }
        }
      }
    },
