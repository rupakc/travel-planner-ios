    "onboarding:steps.welcome.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI দিয়ে ভ্রমণের পরিকল্পনা করুন: ফ্লাইট, হোটেল, কার্যকলাপ এবং দিনভিত্তিক ভ্রমণসূচি, সবকিছু এক জায়গায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plane Reisen mit KI: Flüge, Hotels, Aktivitäten und ein Tag-für-Tag-Reiseplan, alles an einem Ort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan trips with AI: flights, hotels, activities and a day-by-day itinerary, all in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifica viajes con IA: vuelos, hoteles, actividades y un itinerario día a día, todo en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Planifiez vos voyages avec l'IA : vols, hôtels, activités et un programme jour par jour, le tout au même endroit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI से यात्राएँ प्लान करें: उड़ानें, होटल, गतिविधियाँ और दिन-दर-दिन का कार्यक्रम, सब एक ही जगह।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用 AI 规划旅行：航班、酒店、活动和逐日行程，一站搞定。"
          }
        }
      }
    },
