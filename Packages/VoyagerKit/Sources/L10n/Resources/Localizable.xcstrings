    "alerts:email.helpOff" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সার্ভার এখনো ইমেইল পাঠাচ্ছে না — অ্যাপে অ্যালার্ট ঠিকই পাবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Server versendet noch keine E-Mails – Preisalarme bekommst du weiterhin in der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This server isn’t sending email yet — you’ll still get alerts in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este servidor aún no envía correos: seguirás recibiendo las alertas en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce serveur n’envoie pas encore d’e-mails ; vous recevrez quand même les alertes dans l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सर्वर अभी ईमेल नहीं भेज रहा — अलर्ट आपको ऐप में फिर भी मिलेंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此服务器暂未发送邮件，应用内仍会收到价格提醒。"
          }
        }
      }
    },
    "alerts:email.helpOn" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু সেই ভাড়ার ট্র্যাকিংয়ের জন্য, যেগুলো আপনি ইমেইলে পেতে চান। মুছতে ফাঁকা রাখুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nur für Preisbeobachtungen genutzt, die du per E-Mail erhalten möchtest. Leer lassen, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only used for fare watches you choose to get by email. Leave empty to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se usa para los seguimientos de tarifas que elijas recibir por correo. Déjalo vacío para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé uniquement pour les surveillances de tarifs que vous choisissez de recevoir par e-mail. Laissez vide pour le supprimer."
          }
        },
        "hi" : {
