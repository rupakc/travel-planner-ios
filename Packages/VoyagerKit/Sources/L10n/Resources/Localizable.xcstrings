          "stringUnit" : {
            "state" : "translated",
            "value" : "ध्यान दें कि लौटने के बाद कम से कम छह महीने तक यह वैध रहे और इसमें खाली पन्ने हों।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保返程后至少还有六个月有效期，并留有空白页。"
          }
        }
      }
    },
