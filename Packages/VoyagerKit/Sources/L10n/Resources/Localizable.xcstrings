        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव किराए लगातार तीन बार नहीं मिले, इसलिए जाँच रुकी हुई है। तैयार हों तो “फिर कोशिश करें” दबाएँ।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
