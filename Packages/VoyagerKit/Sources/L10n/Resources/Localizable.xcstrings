        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tarifas en directo fallaron tres veces seguidas, así que las comprobaciones están en pausa. Usa Reintentar cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tarifs en direct ont échoué trois fois de suite ; les vérifications sont donc suspendues. Utilisez Réessayer quand vous voulez."
