        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অ্যাকাউন্টের ইমেইল দিন, নতুন পাসওয়ার্ড বেছে নেওয়ার লিংক পাঠানো হবে।"
