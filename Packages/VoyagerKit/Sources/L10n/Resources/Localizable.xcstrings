    "search:tour.interests.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আগ্রহ আর ডিসকভারি ডায়াল প্রতিটি সুপারিশ ঠিক করে — বিখ্যাত ক্লাসিক থেকে লুকানো রত্ন পর্যন্ত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Interessen und der Entdeckerregler bestimmen jede Empfehlung – von berühmten Klassikern bis zu versteckten Perlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your interests and the discovery dial shape every recommendation — from famous classics to hidden gems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus intereses y el dial de descubrimiento dan forma a cada recomendación, desde los grandes clásicos hasta joyas ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos centres d’intérêt et le curseur de découverte façonnent chaque recommandation, des grands classiques aux pépites cachées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रुचियाँ और डिस्कवरी डायल हर सुझाव को आकार देते हैं — मशहूर क्लासिक जगहों से लेकर छिपे हुए रत्नों तक।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的兴趣和探索偏好会影响每一条推荐，从知名经典到小众宝藏。"
          }
        }
      }
    },
    "search:tour.interests.title" : {
      "extractionState" : "manual",
      "localizations" : {
