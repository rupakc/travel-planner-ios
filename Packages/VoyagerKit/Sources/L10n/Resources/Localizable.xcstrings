    "coach:steps.trips.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি ভ্রমণ এখানেই থাকে, স্বপ্ন থেকে শেষ পর্যন্ত। প্রস্তুতি, যাত্রা ও স্মৃতি দেখতে একটিতে ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier lebt jede Reise, vom Traum bis zur Erinnerung. Tippe auf eine, um sie vorzubereiten, zu reisen und zurückzublicken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every trip lives here, from dreaming to done. Tap one to prepare, travel and look back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí vive cada viaje, desde la idea hasta el recuerdo. Toca uno para prepararlo, viajar y repasarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque voyage vit ici, de l'idée au souvenir. Touchez-en un pour le préparer, voyager et revenir dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर यात्रा यहीं रहती है, सपने से लेकर पूरी होने तक। तैयारी, सफ़र और यादों के लिए किसी एक को खोलें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一次旅行都在这里，从构想到完成。点开一个即可准备、出行和回顾。"
          }
        }
      }
    },
    "coach:steps.trips.title" : {
