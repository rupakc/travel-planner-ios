    "onboarding:steps.howYouTravel.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছয়টি ছোট প্রশ্ন Voyager-কে আপনার মতো করে সাজাবে। যেকোনো প্রশ্ন এড়িয়ে যেতে পারেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sechs kurze Fragen passen Voyager an dich an. Du kannst jede überspringen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six quick questions tailor Voyager to you. You can skip any of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis preguntas rápidas adaptan Voyager a ti. Puedes omitir cualquiera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Six questions rapides adaptent Voyager à vous. Vous pouvez en passer n'importe laquelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छह छोटे सवाल Voyager को आपके अनुसार ढालते हैं। आप किसी को भी छोड़ सकते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "六个简短问题，让 Voyager 更贴合你。任何一个都可以跳过。"
          }
        }
      }
    },
