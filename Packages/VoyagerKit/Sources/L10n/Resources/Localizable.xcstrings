    "verify:verify.emailChanged" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই লিংক পাঠানোর পর আপনার ইমেইল ঠিকানা বদলেছে। আপনার ইমেইল দিন, আমরা নতুন লিংক পাঠাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine E-Mail-Adresse hat sich seit dem Versand dieses Links geändert. Gib deine E-Mail ein und wir senden einen neuen Link."
