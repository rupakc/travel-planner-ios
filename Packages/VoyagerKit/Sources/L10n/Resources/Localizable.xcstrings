    "privacy:prompt.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ত্রুটি সারাতে ও অ্যাপ উন্নত করতে আমরা ব্যবহার-তথ্য (স্ক্রিন, ট্যাপ, সময়) সংগ্রহ করি, যা একটি র‍্যান্ডম আইডির সঙ্গে, বা সাইন ইন থাকলে আপনার অ্যাকাউন্টের সঙ্গে যুক্ত। আপনি যা টাইপ করেন, আপনার অবস্থান বা ইমেইল কখনও নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erfassen Nutzungsdaten (Ansichten, Antippen, Zeiten), verknüpft mit einer zufälligen ID oder, wenn du angemeldet bist, mit deinem Konto, um Fehler zu beheben und die App zu verbessern. Nie, was du eingibst, deinen Standort oder deine E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We collect usage data (screens, taps, timings), tied to a random ID or to your account when signed in, to fix bugs and improve the app. Never what you type, your location or your email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recopilamos datos de uso (pantallas, toques, tiempos) vinculados a un ID aleatorio o, si has iniciado sesión, a tu cuenta, para corregir errores y mejorar la app. Nunca lo que escribes, tu ubicación ni tu correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous collectons des données d’usage (écrans, appuis, durées), liées à un identifiant aléatoire ou, si vous êtes connecté, à votre compte, pour corriger les bugs et améliorer l’appli. Jamais ce que vous saisissez, votre position ni votre e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बग ठीक करने और ऐप सुधारने के लिए हम उपयोग डेटा (स्क्रीन, टैप, समय) इकट्ठा करते हैं, जो एक रैंडम आईडी से, या साइन इन होने पर आपके खाते से जुड़ा होता है। आप जो टाइप करते हैं, आपकी लोकेशन या ईमेल कभी नहीं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们收集使用数据（页面、点按、耗时），关联到随机 ID；登录后则关联到你的账号，用于修复问题和改进应用。绝不包含你输入的内容、位置或邮箱。"
          }
        }
      }
    },
    "privacy:prompt.deny" : {
