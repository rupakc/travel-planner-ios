    "search:import.file.heic" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-এর HEIC ছবি এখনো পড়া যায় না — বরং স্ক্রিনশট নিন (স্ক্রিনশট PNG হয়), অথবা JPEG হিসেবে এক্সপোর্ট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-HEIC-Fotos können noch nicht gelesen werden – mache stattdessen einen Screenshot (Screenshots sind PNG) oder exportiere als JPEG."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone HEIC photos can't be read yet — take a screenshot instead (screenshots are PNG), or export it as JPEG."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos HEIC del iPhone aún no se pueden leer: haz una captura de pantalla (son PNG) o expórtala como JPEG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos HEIC de l’iPhone ne sont pas encore lisibles : faites plutôt une capture d’écran (au format PNG) ou exportez en JPEG."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone की HEIC फ़ोटो अभी पढ़ी नहीं जा सकतीं — इसके बजाय स्क्रीनशॉट लें (स्क्रीनशॉट PNG होते हैं) या JPEG में एक्सपोर्ट करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂不支持读取 iPhone 的 HEIC 照片——请改用截图（截图是 PNG 格式），或导出为 JPEG。"
          }
        }
      }
    },
    "search:import.file.notImage" : {
