    "coach:steps.play.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরিকল্পনা ও ভ্রমণের জন্য পয়েন্ট ও ব্যাজ জিতুন। পুরোপুরি ঐচ্ছিক।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammle Punkte und Abzeichen fürs Planen und Reisen. Völlig freiwillig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earn points and badges for planning and travelling. Totally optional."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gana puntos e insignias por planificar y viajar. Totalmente opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagnez des points et des badges en planifiant et en voyageant. Totalement facultatif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजना बनाने और यात्रा करने पर पॉइंट और बैज कमाएँ। पूरी तरह वैकल्पिक।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "规划和出行都能赚取积分和徽章。完全可选。"
          }
        }
      }
    },
