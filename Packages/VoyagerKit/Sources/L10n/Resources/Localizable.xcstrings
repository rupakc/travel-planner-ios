    "savings:caveat" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রথম দেখা দাম আর আমরা আপনাকে যে সর্বনিম্ন দামের কথা জানিয়েছি তার পার্থক্য, শুধু USD নজরদারিতে। আপনি ওই দামে বুক করলেই এটি আসল টাকা হবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Unterschied zwischen dem ersten gesehenen Preis und dem niedrigsten Preis, über den wir dich informiert haben, nur bei USD-Beobachtungen. Er wird nur dann zu Geld, wenn du zu diesem Preis buchst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drop between the first price we saw and the lowest price we alerted you about, on USD watches only. It only turns into money if you book at that price."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diferencia entre el primer precio que vimos y el más bajo del que te avisamos, solo en seguimientos en USD. Solo se convierte en dinero si reservas a ese precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écart entre le premier prix observé et le plus bas dont nous vous avons alerté, sur les suivis en USD uniquement. Il ne devient de l’argent que si vous réservez à ce prix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहली देखी गई कीमत और उस सबसे कम कीमत का अंतर, जिसकी हमने आपको सूचना दी, केवल USD निगरानी पर। यह तभी असली पैसों में बदलता है जब आप उसी कीमत पर बुक करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指首次看到的价格与我们提醒过你的最低价之间的差额，仅统计 USD 价格关注。只有你按该价格预订，它才会变成真正的钱。"
          }
        }
      }
    },
