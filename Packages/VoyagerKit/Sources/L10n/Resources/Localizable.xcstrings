      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিশ্বব্যাপী বোর্ডে শুধু হ্যান্ডেল দেখায়, আর শুধু যাঁরা যোগ দেন তাঁদের। আপনি কি যোগ দিতে চান?"
