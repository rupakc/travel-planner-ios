    "alerts:hotel.switchFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওই হোটেলে বদলানো যায়নি — আপনি এখনো প্রথমটিই ট্র্যাক করছেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wechsel zu diesem Hotel hat nicht geklappt – du beobachtest weiterhin das erste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t switch to that hotel — you’re still watching the first one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cambiar a ese hotel: sigues vigilando el primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de passer à cet hôtel : vous surveillez toujours le premier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस होटल पर स्विच नहीं हो सका — आप अब भी पहला होटल ट्रैक कर रहे हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换到该酒店，你仍在关注第一家。"
          }
        }
      }
    },
    "alerts:hotel.switchLost" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওই হোটেলে বদলানো যায়নি, প্রথমটিও ফিরিয়ে আনা যায়নি — এর কার্ড থেকে আবার ট্র্যাক করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wechsel zu diesem Hotel hat nicht geklappt und das erste konnte nicht wiederhergestellt werden – beobachte es erneut über seine Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t switch to that hotel, and the first one couldn’t be put back — watch it again from its card."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cambiar a ese hotel ni restaurar el primero: vuelve a vigilarlo desde su tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de passer à cet hôtel, et le premier n’a pas pu être rétabli : surveillez-le à nouveau depuis sa fiche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस होटल पर स्विच नहीं हो सका और पहला भी वापस नहीं लगाया जा सका — उसे उसके कार्ड से फिर ट्रैक करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法切换到该酒店，第一家也未能恢复，请在其卡片上重新关注。"
          }
        }
      }
    },
