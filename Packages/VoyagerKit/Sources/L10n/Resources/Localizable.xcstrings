    "social:report.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কী সমস্যা তা আমাদের জানান। যাচাই করা ব্যক্তিদের তিনটি রিপোর্ট পেলে মডারেটর দেখা পর্যন্ত এটি লুকানো থাকবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns, was nicht stimmt. Drei Meldungen von verifizierten Personen blenden den Inhalt aus, bis ein Moderator ihn geprüft hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us what is wrong. Three reports from verified people hide it until a moderator has looked."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos qué pasa. Tres denuncias de personas verificadas lo ocultan hasta que un moderador lo revise."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-nous ce qui ne va pas. Trois signalements de personnes vérifiées le masquent jusqu'à ce qu'un modérateur l'examine."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताइए क्या गड़बड़ है। सत्यापित लोगों की तीन रिपोर्ट मिलने पर यह तब तक छिपा रहेगा जब तक कोई मॉडरेटर इसे देख न ले।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
