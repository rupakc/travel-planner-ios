    "notifications:noDevices" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসে পুশ বিজ্ঞপ্তি এখনও পাওয়া যায় না। পেতে Voyager অ্যাপ ইনস্টল করে সাইন ইন করুন; অ্যাপের ভেতরের বিজ্ঞপ্তি তবুও কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push-Benachrichtigungen sind auf diesem Gerät noch nicht verfügbar. Installiere die Voyager-App und melde dich an, um sie zu erhalten; Benachrichtigungen in der App funktionieren weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Push notifications are not available on this device yet. Install the Voyager app and sign in to receive them; in-app notifications still work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones push aún no están disponibles en este dispositivo. Instala la app de Voyager e inicia sesión para recibirlas; las notificaciones dentro de la app siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications push ne sont pas encore disponibles sur cet appareil. Installez l'application Voyager et connectez-vous pour les recevoir ; les notifications dans l'application fonctionnent toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर पुश सूचनाएँ अभी उपलब्ध नहीं हैं। उन्हें पाने के लिए Voyager ऐप इंस्टॉल करें और साइन इन करें; ऐप के अंदर की सूचनाएँ फिर भी काम करती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备暂不支持推送通知。安装 Voyager 应用并登录即可接收;应用内通知仍可正常使用。"
          }
        }
      }
    },
