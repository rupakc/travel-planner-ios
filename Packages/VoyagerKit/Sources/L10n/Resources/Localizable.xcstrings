    "search:tour.plan.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফ্লাইট, হোটেল, ভিসা, আবহাওয়া ও আরও অনেক কিছু একটি একটি অংশ করে আসে — প্রথম ফলাফল কয়েক সেকেন্ডেই দেখা যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flüge, Hotels, Visum, Wetter und mehr treffen Abschnitt für Abschnitt ein – die ersten Ergebnisse erscheinen nach wenigen Sekunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flights, hotels, visa, weather and more stream in section by section — the first results appear within seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelos, hoteles, visado, clima y más llegan sección por sección; los primeros resultados aparecen en segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols, hôtels, visa, météo et plus arrivent section par section : les premiers résultats apparaissent en quelques secondes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़्लाइट, होटल, वीज़ा, मौसम और बहुत कुछ हिस्से-हिस्से में आता है — पहले नतीजे कुछ ही सेकंड में दिख जाते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "航班、酒店、签证、天气等内容会逐个板块陆续显示，几秒内就能看到第一批结果。"
          }
        }
      }
    },
    "search:tour.plan.title" : {
