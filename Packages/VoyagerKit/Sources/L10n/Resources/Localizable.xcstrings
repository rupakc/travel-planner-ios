    "onboarding:steps.homeAndPassport.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কোথা থেকে উড়ে যান এবং কোন পাসপোর্ট ধারণ করেন তা জানান, যাতে আমরা ভিসা যাচাই করতে ও সঠিক ফ্লাইট খুঁজে দিতে পারি।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag uns, von wo du fliegst und welchen Reisepass du hast, damit wir Visa prüfen und passende Flüge finden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us where you fly from and which passport you hold, so we can check visas and find the right flights."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos desde dónde vuelas y qué pasaporte tienes, para comprobar los visados y encontrar los vuelos adecuados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez d'où vous partez et quel passeport vous détenez, afin que nous vérifiions les visas et trouvions les bons vols."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताइए कि आप कहाँ से उड़ान भरते हैं और आपके पास कौन-सा पासपोर्ट है, ताकि हम वीज़ा जाँच सकें और सही उड़ानें ढूँढ सकें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我们你从哪里出发、持有哪国护照，以便我们核查签证并找到合适的航班。"
          }
        }
      }
    },
