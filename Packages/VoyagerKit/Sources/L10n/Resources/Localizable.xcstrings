        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} no es una de las paradas de este viaje y un viaje tiene como máximo 3: añádelo a una de ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} ne fait pas partie des étapes de ce voyage, et un voyage en compte 3 au maximum : ajoutez-le plutôt à l’une d’elles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{{city}} इस यात्रा का पड़ाव नहीं है, और एक यात्रा में अधिकतम 3 पड़ाव हो सकते हैं — इसे किसी मौजूदा पड़ाव में जोड़ें।"
