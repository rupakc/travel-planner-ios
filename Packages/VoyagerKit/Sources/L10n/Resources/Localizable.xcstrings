    "search:tour.route.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোথা থেকে কোথায় যাচ্ছেন লিখুন। একাধিক শহরের ভ্রমণের জন্য পথে স্টপ যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein, von wo du abfliegst und wohin es geht. Füge Zwischenstopps für eine Reise durch mehrere Städte hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter where you're flying from and to. Add stops on the way for a multi-city trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica desde dónde vuelas y a dónde. Añade paradas en el camino para un viaje por varias ciudades."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiquez votre ville de départ et votre destination. Ajoutez des étapes pour un voyage multi-villes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताएँ कि आप कहाँ से कहाँ उड़ रहे हैं। कई शहरों की यात्रा के लिए रास्ते में पड़ाव जोड़ें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写出发地和目的地。想玩多个城市，可以添加途经停留点。"
          }
        }
      }
    },
    "search:tour.route.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কোথায় যাচ্ছেন?"
          }
        },
        "de" : {
