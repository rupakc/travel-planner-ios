        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovechando cada céntimo: hostales, comida callejera, free tours a pie y alertas de ofertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
