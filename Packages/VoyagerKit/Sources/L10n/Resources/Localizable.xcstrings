      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্যবহার-তথ্য শেয়ার করুন, যা র‍্যান্ডম আইডির সঙ্গে বা সাইন ইন থাকলে আপনার অ্যাকাউন্টের সঙ্গে যুক্ত। আপনি যা টাইপ করেন, আপনার অবস্থান বা ইমেইল কখনও নয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile Nutzungsdaten, verknüpft mit einer zufälligen ID oder, wenn du angemeldet bist, mit deinem Konto. Nie, was du eingibst, deinen Standort oder deine E-Mail."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share usage data tied to a random ID, or to your account when signed in. Never what you type, your location or your email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte datos de uso vinculados a un ID aleatorio o, con sesión iniciada, a tu cuenta. Nunca lo que escribes, tu ubicación ni tu correo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez des données d’usage liées à un identifiant aléatoire ou, si vous êtes connecté, à votre compte. Jamais ce que vous saisissez, votre position ni votre e-mail."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपयोग डेटा शेयर करें, जो रैंडम आईडी से या साइन इन होने पर आपके खाते से जुड़ा होता है। आपका टाइप किया हुआ, आपकी लोकेशन या ईमेल कभी नहीं।"
