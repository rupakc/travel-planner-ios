    "alerts:trip.lookup" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুরু করলে আমরা আপনার ফ্লাইট (আপনার তারিখের সবচেয়ে সস্তা ভাড়া, নির্দিষ্ট কোনো ফ্লাইট নয়), হোটেল ও সর্বোচ্চ ৫টি অ্যাক্টিভিটির লাইভ দাম দেখি এবং লাইভ মোট দেখাই। যার লাইভ দাম নেই, সেটি অনুমানেই থাকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Start rufen wir Live-Preise für deinen Flug (den günstigsten Preis an deinen Daten, nicht einen bestimmten Flug), das Hotel und bis zu 5 Aktivitäten ab und zeigen die Live-Summe. Alles ohne Live-Preis bleibt bei der Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you start, we look up live prices for your flight (the cheapest fare on your dates, not one specific flight), hotel and up to 5 activities, and show the live total. Anything without a live price stays at its estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al empezar, buscamos precios en directo para tu vuelo (la tarifa más barata en tus fechas, no un vuelo concreto), el hotel y hasta 5 actividades, y mostramos el total en directo. Lo que no tenga precio en directo se queda en su estimación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au démarrage, nous cherchons les prix en direct de votre vol (le tarif le moins cher à vos dates, pas un vol précis), de l’hôtel et de jusqu’à 5 activités, puis affichons le total en direct. Tout ce qui n’a pas de prix en direct reste à son estimation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने पर हम आपकी फ़्लाइट (आपकी तारीख़ों का सबसे सस्ता किराया, कोई एक ख़ास फ़्लाइट नहीं), होटल और 5 तक गतिविधियों की लाइव कीमतें देखते हैं और लाइव कुल दिखाते हैं। जिसकी लाइव कीमत नहीं मिलती, वह अनुमान पर ही रहता है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始关注后，我们会查询你的航班（你所选日期的最低票价，而非某个具体航班）、酒店和最多 5 个活动的实时价格，并显示实时总价。没有实时价格的部分保持估价。"
          }
        }
      }
    },
    "alerts:trip.noMove" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
