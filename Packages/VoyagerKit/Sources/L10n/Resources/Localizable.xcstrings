            "value" : "你最近的搜索都在这里。可以加载后修改，也可以原样再搜一次。"
          }
        }
      }
    },
    "search:tour.recent.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেখানে থেমেছিলেন সেখান থেকে শুরু করুন"
