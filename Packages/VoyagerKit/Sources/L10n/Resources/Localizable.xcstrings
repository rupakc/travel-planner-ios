    "security:providers.setPasswordFirst" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটিই আপনার সাইন-ইনের একমাত্র উপায়। আগে একটি পাসওয়ার্ড সেট করুন, তারপর বিচ্ছিন্ন করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist deine einzige Anmeldemethode. Lege zuerst ein Passwort fest und trenne dann die Verbindung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your only way to sign in. Set a password first, then disconnect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tu única forma de iniciar sesión. Primero crea una contraseña y luego desconecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est votre seule façon de vous connecter. Définissez d'abord un mot de passe, puis déconnectez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह साइन-इन का आपका एकमात्र तरीका है। पहले पासवर्ड सेट करें, फिर इसे अलग करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
