    "alerts:hotel.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন আপনার তারিখে কোনো রুম নেই। আমরা দেখতে থাকব এবং ফিরে না আসা পর্যন্ত অ্যালার্ট দেব না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für deine Daten sind derzeit keine Zimmer frei. Wir prüfen weiter und melden uns erst, wenn wieder welche da sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rooms for your dates right now. We’ll keep checking and won’t alert you until it’s back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay habitaciones para tus fechas ahora mismo. Seguiremos comprobando y no te avisaremos hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune chambre pour vos dates actuellement. Nous continuons de vérifier et ne vous alerterons qu’à leur retour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी आपकी तारीख़ों के लिए कोई कमरा नहीं। हम जाँचते रहेंगे और वापस आने तक अलर्ट नहीं भेजेंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的日期目前没有空房。我们会继续检查，有空房之前不会提醒你。"
          }
        }
      }
    },
