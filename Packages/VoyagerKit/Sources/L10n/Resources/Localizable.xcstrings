    "notifications:quiet.noTimezone" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উপরের সেটিংসে আপনার সময় অঞ্চল ঠিক করুন, যাতে নিরিবিলি সময় জানতে পারে কখন প্রযোজ্য হবে। তার আগে এটি প্রযোজ্য হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle oben in den Einstellungen deine Zeitzone ein, damit die Ruhezeiten wissen, wann sie gelten. Bis dahin werden sie nicht angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set your time zone in Settings above so quiet hours know when to apply. Until then they are not applied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura tu zona horaria en Ajustes, arriba, para que las horas de silencio sepan cuándo aplicarse. Mientras tanto no se aplican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez votre fuseau horaire dans les Paramètres ci-dessus pour que les heures calmes sachent quand s'appliquer. D'ici là, elles ne sont pas appliquées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर सेटिंग में अपना समय क्षेत्र चुनें, ताकि शांत घंटे जान सकें कि कब लागू होना है। तब तक वे लागू नहीं होंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在上方“设置”中选择时区,免打扰时段才知道何时生效。在此之前不会生效。"
          }
        }
      }
    },
