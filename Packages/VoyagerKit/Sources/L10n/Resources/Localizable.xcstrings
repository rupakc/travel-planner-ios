    "alerts:act.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন Google ফলাফলে দামসহ নেই। আমরা খুঁজতে থাকব এবং ফিরে না আসা পর্যন্ত অ্যালার্ট দেব না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derzeit in den Google-Ergebnissen nicht mit Preis gelistet. Wir suchen weiter und melden uns erst, wenn es wieder da ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not currently listed with a price in Google results. We’ll keep looking and won’t alert you until it’s back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora mismo no aparece con precio en los resultados de Google. Seguiremos buscando y no te avisaremos hasta que vuelva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actuellement sans prix dans les résultats Google. Nous continuons de chercher et ne vous alerterons qu’à son retour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी Google नतीजों में कीमत के साथ सूचीबद्ध नहीं है। हम खोजते रहेंगे और वापस आने तक अलर्ट नहीं भेजेंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前 Google 结果中没有带价格的条目。我们会继续查找，重新出现之前不会提醒你。"
          }
        }
      }
    },
