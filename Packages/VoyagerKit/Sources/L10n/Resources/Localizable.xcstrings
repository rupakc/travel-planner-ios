    "alerts:dialog.browser.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager অন্য উইন্ডোতে খোলা থাকলে দাম কমলে আপনার ব্রাউজার ছোট অ্যালার্ট দেখাতে পারে। এটি যেকোনো সময় ব্রাউজারে বদলাতে পারবেন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange Voyager in einem anderen Fenster geöffnet ist, kann dein Browser bei einem Preisrückgang einen kleinen Hinweis anzeigen. Du kannst das jederzeit im Browser ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While Voyager is open in another window, your browser can show a small alert when a price drops. You can change this in your browser any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras Voyager esté abierto en otra ventana, tu navegador puede mostrar un aviso breve cuando baje un precio. Puedes cambiarlo en tu navegador cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que Voyager est ouvert dans une autre fenêtre, votre navigateur peut afficher une petite alerte quand un prix baisse. Vous pouvez le modifier à tout moment dans votre navigateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब Voyager किसी दूसरी विंडो में खुला हो, तब कीमत गिरने पर आपका ब्राउज़र एक छोटा अलर्ट दिखा सकता है। इसे आप कभी भी ब्राउज़र में बदल सकते हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Voyager 在另一个窗口中打开时，价格下降后浏览器可以弹出一条小提醒。你随时可以在浏览器中更改。"
          }
        }
      }
    },
