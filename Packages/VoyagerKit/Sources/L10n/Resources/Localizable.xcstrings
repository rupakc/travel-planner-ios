      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন আপনার তারিখে পাওয়া যাচ্ছে না। আমরা দেখতে থাকব এবং ফিরে না আসা পর্যন্ত অ্যালার্ট দেব না।"
