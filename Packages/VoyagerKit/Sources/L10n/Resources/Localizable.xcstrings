    "search:import.subheading" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্লগ, YouTube বা TikTok ভিডিও, বন্ধুর বার্তা বা স্ক্রিনশট — আমরা প্রতিটি জায়গা খুঁজে সেগুলোর চারপাশে দিনগুলো সাজাব।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Blog, ein YouTube- oder TikTok-Video, die Nachricht eines Freundes oder ein Screenshot – wir finden jeden Ort und planen die Tage drumherum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A blog, a YouTube or TikTok video, a friend's message or a screenshot — we'll find every place and plan the days around them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un blog, un vídeo de YouTube o TikTok, el mensaje de un amigo o una captura: encontraremos cada lugar y planificaremos los días a su alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un blog, une vidéo YouTube ou TikTok, le message d’un ami ou une capture d’écran : nous trouvons chaque lieu et organisons vos journées autour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई ब्लॉग, YouTube या TikTok वीडियो, दोस्त का संदेश या स्क्रीनशॉट — हम हर जगह ढूँढकर उनके आसपास दिन प्लान कर देंगे।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "博客、YouTube 或 TikTok 视频、朋友的消息或截图都可以，我们会找出每个地点并围绕它们安排每天的行程。"
          }
        }
      }
    },
