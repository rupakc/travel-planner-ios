    "misc:nearby.geo.denied" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager-এর জন্য অবস্থানের অনুমতি বন্ধ আছে। ব্রাউজারের সেটিংসে এই সাইটের জন্য অবস্থান অনুমতি দিন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Standortzugriff ist für Voyager ausgeschaltet. Erlaube den Standort für diese Website in den Browsereinstellungen und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is turned off for Voyager. Allow location for this site in your browser’s settings, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado para Voyager. Permite la ubicación para este sitio en los ajustes del navegador y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position est désactivé pour Voyager. Autorisez la localisation pour ce site dans les réglages de votre navigateur, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager के लिए लोकेशन एक्सेस बंद है। अपने ब्राउज़र की सेटिंग में इस साइट के लिए लोकेशन की अनुमति दें, फिर दोबारा कोशिश करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭 Voyager 的位置访问权限。请在浏览器设置中允许此网站使用位置信息，然后重试。"
          }
        }
      }
    },
    "misc:nearby.geo.timeout" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অবস্থান খুঁজতে অনেক সময় লেগেছে। আবার চেষ্টা করুন — দ্বিতীয়বার প্রায়ই দ্রুত হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Standortbestimmung hat zu lange gedauert. Versuche es erneut – beim zweiten Mal geht es oft schneller."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finding your location took too long. Try again — it’s often quicker the second time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar tu ubicación tardó demasiado. Inténtalo de nuevo: suele ser más rápido la segunda vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recherche de votre position a pris trop de temps. Réessayez : c’est souvent plus rapide la seconde fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी लोकेशन खोजने में बहुत समय लगा। फिर कोशिश करें — दूसरी बार अक्सर जल्दी हो जाता है।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取位置用时过长。请重试——第二次通常会更快。"
          }
        }
      }
    },
    "misc:nearby.geo.unavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার ডিভাইস বুঝতে পারেনি আপনি কোথায় আছেন। লোকেশন সার্ভিস চালু আছে কিনা দেখুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät konnte nicht feststellen, wo du bist. Prüfe, ob die Ortungsdienste eingeschaltet sind, und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device couldn’t work out where you are. Check that location services are on, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo no pudo determinar dónde estás. Comprueba que los servicios de ubicación estén activados y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil n’a pas pu déterminer où vous êtes. Vérifiez que la localisation est activée, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका डिवाइस पता नहीं लगा सका कि आप कहाँ हैं। जाँचें कि लोकेशन सेवाएँ चालू हैं, फिर दोबारा कोशिश करें।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的设备无法确定所在位置。请确认已开启定位服务，然后重试。"
          }
        }
      }
    },
    "misc:nearby.geo.unsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ব্রাউজার আপনার অবস্থান শেয়ার করতে পারে না, তাই “আমার কাছে” এখানে কাজ করবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Browser kann deinen Standort nicht teilen, daher funktioniert „In der Nähe“ hier nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This browser can’t share your location, so Near me can’t work here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este navegador no puede compartir tu ubicación, así que Cerca de mí no funciona aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce navigateur ne peut pas partager votre position, « Près de moi » ne peut donc pas fonctionner ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ब्राउज़र आपकी लोकेशन शेयर नहीं कर सकता, इसलिए “मेरे आस-पास” यहाँ काम नहीं करेगा।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此浏览器无法共享你的位置，因此“附近”功能在这里无法使用。"
          }
        }
      }
    },
    "misc:nearby.geoErrorTitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার অবস্থান পাওয়া যায়নি"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten deinen Standort nicht ermitteln"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn’t get your location"
          }
        },
        "es" : {
          "stringUnit" : {
