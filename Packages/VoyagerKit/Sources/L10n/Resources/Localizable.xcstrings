    "notifications:intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyager আপনাকে কী কী পাঠাতে পারবে তা বেছে নিন। এই সেটিংস আপনার অ্যাকাউন্টের সঙ্গে সব ডিভাইসে প্রযোজ্য।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege fest, was Voyager dir schicken darf. Diese Einstellungen gelten für dein Konto auf allen Geräten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what Voyager may send you. These settings follow your account on every device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué puede enviarte Voyager. Estos ajustes acompañan a tu cuenta en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce que Voyager peut vous envoyer. Ces réglages suivent votre compte sur tous vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि Voyager आपको क्या भेज सकता है। ये सेटिंग आपके खाते के साथ सभी डिवाइस पर लागू रहती हैं।"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 Voyager 可以向你发送哪些内容。这些设置会随你的账户同步到所有设备。"
          }
        }
      }
    },
